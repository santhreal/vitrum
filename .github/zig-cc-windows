#!/usr/bin/env python3
"""zig as the C compiler for the Windows cross check.

`cargo check` never links, but it does run build scripts, and the one in
`ring` compiles C. Nothing else on a Linux runner can compile C for Windows,
while zig is already installed here to build the terminal engine.

Callers pass the Rust triple through as `--target x86_64-pc-windows-gnu`,
which zig does not parse: it wants `x86_64-windows-gnu`. Drop the argument
and supply zig's spelling instead.
"""

import os
import sys

args: list[str] = []
skip = False
for arg in sys.argv[1:]:
    if skip:
        skip = False
        continue
    if arg in ("--target", "-target"):
        skip = True
        continue
    if arg.startswith("--target="):
        continue
    args.append(arg)

os.execvp("zig", ["zig", "cc", "-target", "x86_64-windows-gnu", *args])
