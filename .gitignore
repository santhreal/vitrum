# Build output. `CARGO_TARGET_DIR` may point elsewhere; this covers the default.
/target/
**/target/

# Zig's package cache and build output. `vitrum-vt` builds libghostty-vt with
# the Zig toolchain, which drops these in whatever directory it runs from, and
# the cache holds tens of thousands of files from other people's projects.
**/.zig-cache/
**/zig-out/

# Release archives and their checksum file, written by
# `packaging/build-release-asset.sh`. They are attached to a GitHub release,
# never committed: the digest changes on every rebuild of the same source.
/dist/

# Local notes. Not published.
BACKLOG.md
/.internal/

# Capture artifacts. Scoped, NOT a global *.png: a blanket rule would silently
# swallow the first icon or asset anybody adds under app/assets.
/harness/out/
/*.png
/*.ppm

# Editor and OS leavings.
.DS_Store
*.swp
*~

# Bytecode the harness's python leaves beside itself. A stray directory here
# is not a defect, but `cut.sh` refuses a dirty tree and a compile check
# should not be able to stop a release.
__pycache__/
