#!/usr/bin/env python3
"""Translate a Claude Code hook event into a vitrum status hint.

Approval and Input cannot be observed from a PTY: an agent asking to
force-push and a shell sitting at a prompt block on the same read. vitrum
therefore only shows those states when the agent declares them, and this is
the declaring half for Claude Code.

usage: vitrum-claude-hook <approval|input|working|ready>

The hook event's JSON arrives on stdin, and its `message` becomes the row's
label when there is one.

Delivery is the awkward part. A hook's stdout belongs to Claude Code, and
Claude runs hooks with no controlling terminal at all, so /dev/tty is
ENXIO rather than the session. The sequence has to reach the pty that
vitrum is reading, so this walks up the process tree until it finds an
ancestor holding a /dev/pts device open and writes there.
"""
import json
import os
import subprocess
import sys

STATES = ("approval", "input", "working", "ready")
LOG = os.environ.get("VITRUM_HOOK_LOG")


def note(line: str) -> None:
    """Optional breadcrumb. Silent unless VITRUM_HOOK_LOG names a file."""
    if not LOG:
        return
    try:
        with open(LOG, "a") as log:
            log.write(line + "\n")
    except OSError:
        pass


def parent_of(pid: int) -> int:
    """The ppid from /proc/<pid>/stat, reading past a comm with spaces."""
    with open(f"/proc/{pid}/stat") as stat:
        return int(stat.read().rsplit(")", 1)[1].split()[1])


def session_pty(start: int, hops: int = 12) -> str | None:
    """The pty an ancestor of `start` is attached to, nearest first."""
    pid = start
    for _ in range(hops):
        for fd in ("1", "0", "2"):
            try:
                target = os.readlink(f"/proc/{pid}/fd/{fd}")
            except OSError:
                continue
            if target.startswith("/dev/pts/"):
                return target
        try:
            nxt = parent_of(pid)
        except (OSError, ValueError, IndexError):
            return None
        if nxt <= 1 or nxt == pid:
            return None
        pid = nxt
    return None


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in STATES:
        print(__doc__, file=sys.stderr)
        return 2
    state = sys.argv[1]

    raw = sys.stdin.read()
    label = None
    try:
        text = json.loads(raw).get("message")
        if isinstance(text, str) and text.strip():
            label = text.strip()
    except Exception:
        pass

    args = ["vitrum", "hint", state] + ([label] if label else [])
    try:
        done = subprocess.run(args, capture_output=True, text=True, timeout=5)
    except Exception as exc:  # a missing vitrum must never break the agent
        note(f"{state}: spawn failed: {exc}")
        return 0
    if done.returncode != 0:
        note(f"{state}: hint exit {done.returncode}: {done.stderr.strip()}")
        return 0

    pty = session_pty(os.getppid())
    if pty is None:
        note(f"{state}: no pty among my ancestors")
        return 0
    try:
        with open(pty, "w") as out:
            out.write(done.stdout)
    except OSError as exc:
        note(f"{state}: write to {pty} failed: {exc}")
        return 0
    note(f"{state}: {len(done.stdout)} bytes to {pty}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
